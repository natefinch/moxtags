{
  "name": "moxtags",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "description": "Adds Scryfall Tagger card and art tag menus, tag panels, search helpers, and autocomplete to Moxfield, Scryfall, and Archidekt.",
  "scripts": {
    "build": "node build.js",
    "build:chrome": "node build.js chrome",
    "build:firefox": "node build.js firefox",
    "package:chrome": "node build.js chrome && node scripts/package-release-assets.js chrome",
    "release:manual-chrome": "./release.sh --skip-chrome",
    "release:manual-chrome:patch": "./release.sh --skip-chrome --patch",
    "sign:firefox": "node build.js firefox && web-ext sign --source-dir=dist/firefox/ --artifacts-dir=web-ext-artifacts/ --channel=unlisted --api-key=\"$AMO_JWT_ISSUER\" --api-secret=\"$AMO_JWT_SECRET\"",
    "watch": "node build.js --watch",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "test:build": "node build.js && node --test tests/build-smoke.test.js tests/release-package-smoke.test.js",
    "test:e2e": "node build.js && playwright test",
    "test:e2e:firefox": "node build.js firefox && node --test tests/e2e/firefox-webdriver.test.js",
    "test:firefox-lint": "node build.js firefox && web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "chrome-webstore-upload-cli": "^3.5.0",
    "esbuild": "^0.25.0",
    "geckodriver": "^6.1.0",
    "linkedom": "^0.18.12",
    "selenium-webdriver": "^4.44.0",
    "web-ext": "^10.1.0"
  }
}
