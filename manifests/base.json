{
  "manifest_version": 3,
  "name": "MoxTags",
  "version": "1.7.0",
  "author": "Nate Finch",
  "homepage_url": "https://github.com/natefinch/moxtags",
  "description": "Adds Scryfall Tagger card and art tag menus, tag panels, search helpers, and autocomplete to Moxfield, Scryfall, and Archidekt.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api2.moxfield.com/*",
    "https://api.scryfall.com/*"
  ],
  "icons": {
    "16": "icons/moxtags-gem-16.png",
    "32": "icons/moxtags-gem-32.png",
    "48": "icons/moxtags-gem-48.png",
    "128": "icons/moxtags-gem-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moxfield.com/decks/*",
        "https://www.moxfield.com/decks/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://moxfield.com/decks/*",
        "https://www.moxfield.com/decks/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scryfall.com/card/*",
        "https://www.scryfall.com/card/*",
        "https://scryfall.com/search*",
        "https://www.scryfall.com/search*"
      ],
      "js": [
        "scryfall_content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archidekt.com/*",
        "https://www.archidekt.com/*"
      ],
      "js": [
        "archidekt_content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/moxtags-gem-16.png",
      "32": "icons/moxtags-gem-32.png",
      "48": "icons/moxtags-gem-48.png",
      "128": "icons/moxtags-gem-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "MoxTags"
  }
}
